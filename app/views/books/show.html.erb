<div class="container mx-auto px-4 py-8">
  <%= render @book %>

  <div class="mt-8">
    <%# --- 貸出ボタン --- %>
    <% if logged_in? && !current_user.admin? %>
      <div class="p-4 border rounded-lg bg-gray-50">
        <h3 class="font-bold text-lg mb-2">貸出</h3>
        <p class="mb-4">貸出可能冊数: <%= @book.available_copies %> / <%= @book.total_copies %></p>
        <% if @book.available_copies > 0 %>
          <%= button_to "この本を借りる", loans_path(book_id: @book.id), method: :post, class: "w-full bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
        <% else %>
          <p class="text-red-500 font-semibold">現在、すべて貸出中です。</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 flex items-center gap-4">
    <%= link_to "書籍一覧に戻る", books_path, class: "text-blue-500 hover:text-blue-700" %>

    <%# --- 管理者用メニュー --- %>
    <% if logged_in? && current_user.admin? %>
      <span class="text-gray-300">|</span>
      <%= link_to "この本を編集", edit_admin_book_path(@book), class: "bg-yellow-500 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded" %>
    <% end %>
  </div>
</div>