<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">書籍一覧</h1>
    <% if logged_in? && current_user.admin? %>
      <%= link_to "新しい書籍を登録", new_book_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    <% end %>
  </div>

  <div id="books" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @books.each do |book| %>
      <div class="border rounded-lg p-4 shadow-sm flex flex-col justify-between">
        <div>
          <%= render book %>
          <p class="mt-4">
            <%= link_to "詳細を見る", book, class: "text-blue-500 hover:text-blue-700" %>
          </p>
        </div>
        <%# --- 学生向けの貸出ボタン --- %>
        <% if logged_in? && !current_user.admin? %>
          <div class="mt-4 pt-4 border-t">
            <p class="text-sm mb-2">貸出可能: <%= book.available_copies %> / <%= book.total_copies %></p>
            <% if book.available_copies > 0 %>
              <%= button_to "この本を借りる", loans_path(book_id: book.id), method: :post, class: "w-full bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
            <% else %>
              <button class="w-full bg-gray-400 text-white font-bold py-2 px-4 rounded cursor-not-allowed" disabled>貸出中</button>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
