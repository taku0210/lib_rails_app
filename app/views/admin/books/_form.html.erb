<%= form_with(model: [:admin, book], class: "space-y-6") do |form| %>
  <% if book.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-700 p-4 rounded-md">
      <h2 class="font-bold"><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h2>
      <ul>
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :title, class: "w-full border-gray-300 rounded-md shadow-sm" %>
  </div>

  <div>
    <%= form.label :author, "著者", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :author, class: "w-full border-gray-300 rounded-md shadow-sm" %>
  </div>

  <div>
    <%= form.label :isbn, "ISBN", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :isbn, class: "w-full border-gray-300 rounded-md shadow-sm" %>
  </div>

  <div>
    <%= form.label :category, "カテゴリ", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :category, class: "w-full border-gray-300 rounded-md shadow-sm" %>
  </div>

  <div>
    <%= form.label :total_copies, "総冊数", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :total_copies, class: "w-full border-gray-300 rounded-md shadow-sm" %>
  </div>

  <div class="flex items-center justify-end gap-4">
    <%= link_to "キャンセル", admin_books_path, class: "text-gray-600 hover:text-gray-900" %>
    <%= form.submit "保存", class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
  </div>
<% end %>