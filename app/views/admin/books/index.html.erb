<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">書籍管理</h1>
    <%= link_to "新しい書籍を登録", new_admin_book_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
  </div>

  <div class="bg-white shadow-md rounded my-6 overflow-x-auto">
    <table class="min-w-full table-auto">
      <thead class="bg-gray-200">
        <tr>
          <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">タイトル</th>
          <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">著者</th>
          <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">ISBN</th>
          <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-sm font-semibold text-gray-700">在庫</th>
          <th class="px-6 py-3 border-b-2 border-gray-300"></th>
        </tr>
      </thead>
      <tbody class="text-gray-700">
        <% @books.each do |book| %>
          <tr class="border-b hover:bg-gray-50">
            <td class="px-6 py-4 font-medium"><%= link_to book.title, admin_book_path(book), class: "hover:text-blue-600" %></td>
            <td class="px-6 py-4"><%= book.author %></td>
            <td class="px-6 py-4"><%= book.isbn %></td>
            <td class="px-6 py-4"><%= book.available_copies %> / <%= book.total_copies %></td>
            <td class="px-6 py-4 text-right whitespace-nowrap">
              <%= link_to '編集', edit_admin_book_path(book), class: "text-indigo-600 hover:text-indigo-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
