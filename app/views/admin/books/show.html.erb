<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div id="<%= dom_id @book %>" class="bg-white p-8 rounded-lg shadow-md">
    <h2 class="text-3xl font-bold mb-4"><%= @book.title %></h2>
    <p class="text-gray-700 mb-2"><strong>著者:</strong> <%= @book.author %></p>
    <p class="text-gray-600"><strong>ISBN:</strong> <%= @book.isbn %></p>
    <p class="text-gray-600"><strong>カテゴリ:</strong> <%= @book.category %></p>
    <p class="text-gray-600"><strong>総冊数:</strong> <%= @book.total_copies %></p>
    <p class="text-gray-600"><strong>貸出可能数:</strong> <%= @book.available_copies %></p>
  </div>
  <div class="mt-6 flex gap-4">
    <%= link_to "編集", edit_admin_book_path(@book), class: "bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded" %>
    <%= link_to "書籍管理一覧へ", admin_books_path, class: "text-blue-600 hover:text-blue-800" %>
  </div>
</div>