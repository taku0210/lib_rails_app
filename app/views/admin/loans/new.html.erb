<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold mb-6">新規貸出登録</h1>

  <div class="bg-white p-8 rounded-lg shadow-md">
    <%= form_with(model: [:admin, @loan], url: admin_loans_path, class: "space-y-6") do |form| %>
      <div>
        <%= form.label :student_no, "利用者 (学籍番号)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag 'loan[student_no]', nil, required: true, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :isbn, "書籍 (ISBN)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= text_field_tag 'loan[isbn]', nil, required: true, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="flex items-center justify-between">
        <%= link_to "キャンセル", admin_loans_path, class: "text-gray-600 hover:text-gray-900" %>
        <%= form.submit "貸出登録", class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>